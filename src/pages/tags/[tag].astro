---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getPosts, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const byTag = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();
	for (const post of posts) {
		for (const tag of post.data.tags) {
			const slug = tagSlug(tag);
			if (!byTag.has(slug)) byTag.set(slug, { name: tag, posts: [] });
			byTag.get(slug)!.posts.push(post);
		}
	}
	return [...byTag].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

const { name, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Posts tagged “${name}”`}
			description={`Tutorials and experiments about ${name} on Supriyo’s Test Lab.`}
			noindex={posts.length < 3}
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>#{name}</h1>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						{' · '}
						<FormattedDate date={post.data.pubDate} />
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
