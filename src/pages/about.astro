---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';

// An About page with real details about you helps Google trust the site (E-E-A-T).
const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		mainEntity: {
			'@type': 'Person',
			name: AUTHOR_NAME,
			jobTitle: 'SEO Practitioner',
			url: new URL('/about/', Astro.site).href,
			knowsAbout: ['Search Engine Optimization', 'Organic Marketing', 'Python', 'Google Apps Script', 'Automation'],
			sameAs: [LINKEDIN_URL, GITHUB_URL],
		},
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About ${AUTHOR_NAME}`}
			description={`${AUTHOR_NAME} is an SEO practitioner with 2.5+ years of experience who writes ${SITE_TITLE}: hands-on SEO, organic marketing and automation experiments.`}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>About me</h1>
			<p>
				Hi, I’m {AUTHOR_NAME}, an SEO practitioner with <strong>2.5+ years of hands-on experience</strong>
				and an enthusiastic learner at heart.
			</p>
			<p>
				I love challenges, automation and ideas that help people. Whenever I run into a boring,
				repetitive task, my first thought is: <em>can I make a computer do this instead?</em> That
				question usually leads me to Python, an API or a few lines of Google Apps Script, and to a
				solution that saves hours.
			</p>
			<h2>Why this blog exists</h2>
			<p>
				I love to learn and I love to teach. {SITE_TITLE} is my public lab notebook: I try new
				experiments in SEO, organic marketing and automation, then write up exactly what I did, what
				broke and what worked, so you can copy the wins and skip the mistakes.
			</p>
			<h2>What you’ll find here</h2>
			<ul>
				<li>Python and API scripts that automate tedious work</li>
				<li>Google Apps Script tricks for Sheets, Gmail, Docs and Forms</li>
				<li>Browser extensions and workflows I use for SEO</li>
				<li>SEO and organic marketing experiments, with real results</li>
			</ul>
			<h2>Get in touch</h2>
			<p>
				Connect with me on <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a> or see my code on
				<a href={GITHUB_URL} rel="me noopener">GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
